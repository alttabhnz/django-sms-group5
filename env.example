# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# NEVER commit the .env file. It is listed in .gitignore.
# This example file contains placeholders only.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- SMS provider -----------------------------------------------------------
# twilio | semaphore | console
#   console = simulation mode: prints the SMS in the terminal, sends nothing
SMS_PROVIDER=console

# Country code used to convert local numbers (09171234567 -> +639171234567)
SMS_DEFAULT_COUNTRY_CODE=63

# Seconds to wait for the provider before showing a timeout error
SMS_REQUEST_TIMEOUT=15

# --- Twilio (only needed when SMS_PROVIDER=twilio) ---------------------------
# Twilio Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio phone number in E.164 format
TWILIO_FROM_NUMBER=+15551234567
# Optional: use a Messaging Service instead of TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=

# --- Semaphore (only needed when SMS_PROVIDER=semaphore) ---------------------
# semaphore.co > Account > API key
SEMAPHORE_API_KEY=your_semaphore_api_key_here
# Your approved sender name (leave blank to use your account's default)
SEMAPHORE_SENDER_NAME=
