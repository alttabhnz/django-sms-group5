# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# NEVER commit the .env file. It is listed in .gitignore.
# This example file contains placeholders only.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- SMS provider -----------------------------------------------------------
# twilio | semaphore | traccar | httpsms | console
#   console = simulation mode: prints the SMS in the terminal, sends nothing
SMS_PROVIDER=console

# Country code used to convert local numbers (09171234567 -> +639171234567)
SMS_DEFAULT_COUNTRY_CODE=63

# Seconds to wait for the provider before showing a timeout error
SMS_REQUEST_TIMEOUT=15

# --- Twilio (only needed when SMS_PROVIDER=twilio) ---------------------------
# Twilio Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio phone number in E.164 format
TWILIO_FROM_NUMBER=+15551234567
# Optional: use a Messaging Service instead of TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=

# --- Semaphore (only needed when SMS_PROVIDER=semaphore) ---------------------
# semaphore.co > Account > API key
SEMAPHORE_API_KEY=your_semaphore_api_key_here
# Your approved sender name (leave blank to use your account's default)
SEMAPHORE_SENDER_NAME=

# --- Traccar SMS Gateway (only needed when SMS_PROVIDER=traccar) -------------
# Install the "Traccar SMS Gateway" app on an Android phone (Google Play),
# open it, enable the HTTP API / gateway service and set an API key.
# Then use the phone's local IP address, e.g. http://192.168.1.245:8082
# (the phone and this computer must be on the same Wi-Fi network).
TRACCAR_GATEWAY_URL=http://192.168.1.245:8082
# The API key set inside the phone app. Secret. Leave blank if the app
# does not require one.
TRACCAR_API_KEY=
# Optional: SIM slot index for dual-SIM phones (0 = first SIM). Blank = default SIM.
TRACCAR_SLOT=

# --- httpSMS (only needed when SMS_PROVIDER=httpsms) -------------------------
# Create a free account at httpsms.com, install the HttpSms.apk app on an
# Android phone, sign in with "Login With API Key" in the app, then copy your
# API key from httpsms.com/settings. The phone sends the SMS with its own SIM
# and reports the real delivery status back to this app.
HTTPSMS_API_KEY=your_httpsms_api_key_here
# The phone number that sends the SMS (registered in the app), local or E.164
HTTPSMS_FROM_NUMBER=09171234567
# Cloud API base URL (change only for a self-hosted instance)
HTTPSMS_SERVER_URL=https://api.httpsms.com
# Shared secret for verifying delivery-receipt webhooks (HS256 JWT).
# Generate one (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
# and put the SAME value in httpsms.com/settings > Webhooks > Signing Key.
# Leave blank to disable the webhook endpoint (all receipts are rejected).
HTTPSMS_WEBHOOK_SIGNING_KEY=
